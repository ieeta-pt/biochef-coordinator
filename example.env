# Copy this file to .env, which git ignores, and change the password.
#
# Docker Compose reads the POSTGRES_ variables to set up the database. The
# service reads the COORDINATOR_ ones.

POSTGRES_USER=coordinator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coordinator

# Where the service finds Postgres when you run it on your machine
# (uv run ...). Under Docker Compose it uses the host "db" instead; see
# compose.yaml. It must use the postgresql+psycopg driver.
COORDINATOR_DATABASE_URL=postgresql+psycopg://coordinator:change-me@localhost:5432/coordinator
